{% extends 'layouts/base_emails.html.twig' %}

{% block body %}
	{# Header Section #}
    <div class="email-header">
        <img src="{{ app.request.schemeAndHttpHost ~ '/assets/emails/img/logo-erp.webp' }}" alt="Logo ERP">
        <h2>Your MyERP Account Has Been Updated</h2>
    </div>
    
    {# Body Section #}
    <div class="email-body">
        <h2>Hello, {{ fullName }}</h2>
        <p>The Email Address for your MyERP account was recently changed.</p>
        <p>If you made this change, no further actions is needed.</p>
        <p>If this wasn't you or you believe an unauthorized person has accessed your account, please reset your password and contact us immediately.</p>
        <a href="#" class="btn">Reset Password</a>
        <br><br>
        <p>Best regards,</p>
        <p><strong>The MyERP Team</strong></p>
    </div>
{% endblock %}

