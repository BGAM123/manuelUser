{% extends 'layouts/base_emails.html.twig' %}

{% block body %}
	{# Header Section #}
    <div class="email-header">
        <img src="{{ app.request.schemeAndHttpHost ~ '/assets/emails/img/logo-erp.webp' }}" alt="Logo ERP">
        <h2>Welcome to Our System</h2>
    </div>
    
    {# Body Section #}
    <div class="email-body">
        <h2>Hello, {{ fullName }}</h2>
        <p>Your account has been successfully created in our system.</p>
        <p><strong>Your username:</strong> {{ username }}</p>
        <p><strong>Your password:</strong> <span style="color: #ff5733;">{{ password }}</span></p>
        <p>Please log in and change your password immediately for security reasons.</p>
        <br><br>
        <p>Best regards,</p>
        <p><strong>The MyERP Team</strong></p>
    </div>
{% endblock %}
