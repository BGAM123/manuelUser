{% extends 'layouts/base_emails.html.twig' %}

{% block body %}
	{# Header Section #}
    <div class="email-header">
        <img src="{{ app.request.schemeAndHttpHost ~ '/assets/emails/img/logo-erp.webp' }}" alt="Logo ERP">
        <h2>Password Reset Request</h2>
    </div>
    
    {# Body Section #}
    <div class="email-body">
        <h2>Hello, {{ fullName }}</h2>
        <p>You recently requested to reset your password for your MyERP account. Click the button below to reset it:</p>
        <a href="{{ link }}" class="btn">Reset Password</a>
        <p>This link will expire in 1 hour. If you did not request a password reset, please ignore this email or contact support if you have questions.</p>
        <br><br>
        <p>Best regards,</p>
        <p><strong>The MyERP Team</strong></p>
    </div>
{% endblock %}
